# FinePrint Phantom environment variables — copy to .env.local locally.
# .env.local is git-ignored. NEVER commit a real key.

# Groq API key (server-side only) serving the open-weight model
# llama-3.3-70b-versatile. Get one free at https://console.groq.com
# Leave empty to run fully in mock/demo mode (heuristic analysis, no calls).
GROQ_API_KEY=

# Force mock mode even when a key is present (1 = mock). Unset/0 = live.
PHANTOM_MOCK=
